# Copia a .env y rellena. NUNCA subas .env al repo.
APP_ENV=development
LOG_LEVEL=INFO

# Local sin Docker: SQLite (no hay que instalar nada).
# Con docker compose se sobreescribe y apunta al contenedor de Postgres.
DATABASE_URL=sqlite:///./trading_bot.db

# Credenciales de Postgres para docker compose
POSTGRES_USER=trading
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=trading_bot

# Alpaca (paper trading) - se usará a partir de HU-04
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
# sip = todo el mercado (plan gratis: solo datos de más de 15 min, ya se gestiona); iex = solo bolsa IEX
ALPACA_FEED=sip
