# ─────────────────────────────────────────────────────────────────────────────
# Trading Bot — Variables de Entorno
# Copiar a .env y rellenar con valores reales.
# NUNCA commitear .env con credenciales reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Alpaca API ────────────────────────────────────────────────────────────────
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYyyy
# paper | live  → Nunca cambiar a live sin revisión manual
TRADING_MODE=paper

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trading:trading@db:5432/tradingbot

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=cambia-esto-por-un-secreto-seguro-de-32-chars
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Estrategia (valores por defecto — editables desde UI) ─────────────────────
MAX_POSITIONS=8
MAX_POSITIONS_PER_SECTOR=3
MIN_SCORE_THRESHOLD=80.0
RISK_PER_TRADE=0.01
SL_ATR_MULTIPLIER=2.0
TP_RISK_RATIO=2.0
PARTIAL_SELL_PERCENT=0.50
MAX_ATR_PCT=5.0

# ── Postgres (para docker-compose) ───────────────────────────────────────────
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=tradingbot
